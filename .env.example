AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Printer Configuration
# Primary: direct USB ESC/POS. The IDs below are Narly's thermal printer ("Virtual PRN").
# A different printer has different IDs: look it up under System Information -> USB.
ESCPOS_USB_VENDOR_ID=0x0485
ESCPOS_USB_PRODUCT_ID=0x5741
ESCPOS_IN_EP=0x82
ESCPOS_OUT_EP=0x01

# Fallback: a system print queue, used only if direct USB fails. Recent macOS can't make the
# raw queue a thermal printer needs, so on a Mac this is rarely useful.
PRINTER_NAME=Manufacture_Virtual_PRN

# Logging
# LOG_FILE is a CLI flag: --log-file path (not read from .env; rotates at 5 MB, keeps 3 backups)

# Microphone
# MIC_NAME is part of the name the mic reports to the computer (case doesn't matter).
# Narly opens the first input device whose name contains it, even if that device isn't
# the computer's default input. The startup log says which one was chosen. If nothing
# matches, he uses the default input. Leave it commented out to look for "fifine": the Fifine AM8
# reports itself as "fifine Microphone", without the model number.
# MIC_NAME=fifine
